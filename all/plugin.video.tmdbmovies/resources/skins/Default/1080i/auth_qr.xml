<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog">
    <defaultcontrol always="true">1000</defaultcontrol>
    <controls>

        <!-- ─── FUNDAL ─────────────────────────────────────────── -->
        <control type="image">
            <left>0</left><top>0</top><width>1920</width><height>1080</height>
            <texture colordiffuse="FF0D0D12">white.png</texture>
        </control>

        <!-- Fanart difuz cu 10% opacitate -->
        <control type="image">
            <left>0</left><top>0</top><width>1920</width><height>1080</height>
            <aspectratio>scale</aspectratio>
            <texture background="true">$INFO[Window.Property(tmdbmovies.fanart)]</texture>
            <colordiffuse>90FFFFFF</colordiffuse>
            <animation effect="fade" start="0" end="100" time="700" tween="sine">WindowOpen</animation>
        </control>

        <!-- ─── CARDUL CENTRAL ─────────────────────────────────────────── -->
        <control type="group">
            <centerleft>50%</centerleft><centertop>50%</centertop>
            <width>920</width><height>450</height>
            <animation effect="zoom" start="80" end="100" center="auto" time="250" tween="back" easing="out">WindowOpen</animation>
            <animation effect="fade" start="0" end="100" time="250">WindowOpen</animation>
            <animation effect="zoom" start="100" end="80" center="auto" time="200" tween="back" easing="in">WindowClose</animation>
            <animation effect="fade" start="100" end="0"  time="200">WindowClose</animation>

            <!-- Fundal cristal (identic TraktRating.xml:992E2E2E) -->
            <control type="image">
                <left>0</left><top>0</top>
                <width>920</width><height>450</height>
                <texture border="20">common/white_rounded.png</texture>
                <colordiffuse>992E2E2E</colordiffuse>
            </control>

            <!-- Buton invizibil (focus pentru mouse / tasta Enter) -->
            <control type="button" id="1000">
                <posx>-2000</posx><posy>-2000</posy><width>1</width><height>1</height>
                <label></label><texturefocus></texturefocus><texturenofocus></texturenofocus>
            </control>

            <!-- Iconita addonului (stanga sus, stil Umbrella) -->
            <control type="image">
                <left>20</left><top>8</top><width>64</width><height>64</height>
                <texture>$INFO[Window.Property(tmdbmovies.auth_addon_icon)]</texture>
                <aspectratio>keep</aspectratio>
            </control>

            <!-- Iconita serviciului (dreapta sus) -->
            <control type="image">
                <left>852</left><top>14</top><width>54</width><height>54</height>
                <texture>$INFO[Window.Property(tmdbmovies.auth_icon)]</texture>
                <aspectratio>keep</aspectratio>
            </control>

            <!-- Heading (titlu serviciu) — centrat -->
            <control type="label">
                <left>96</left><top>22</top><width>728</width><height>40</height>
                <font>font14</font><textcolor>FFCCCCCC</textcolor><align>center</align><aligny>center</aligny>
                <label>$INFO[Window.Property(tmdbmovies.auth_heading)]</label>
            </control>

            <!-- Linie Divider -->
            <control type="image">
                <left>16</left><top>78</top><width>888</width><height>1</height>
                <texture>white.png</texture><colordiffuse>2AFFFFFF</colordiffuse>
            </control>

            <!-- ── QR CODE (dreapta) — direct pe card, fara panou (stil Umbrella);
                 PNG-ul are deja marginea alba de quiet zone din segno -->
            <control type="image">
                <left>640</left><top>105</top><width>250</width><height>250</height>
                <texture>$INFO[Window.Property(tmdbmovies.auth_qr)]</texture>
                <aspectratio align="center" aligny="center">keep</aspectratio>
                <animation effect="fade" start="0" end="100" time="300">WindowOpen</animation>
                <visible>!String.IsEmpty(Window.Property(tmdbmovies.auth_qr))</visible>
            </control>
            <!-- Fallback text daca QR-ul nu a putut fi generat -->
            <control type="label">
                <left>630</left><top>200</top><width>270</width><height>90</height>
                <font>font12</font><textcolor>88FFFFFF</textcolor><align>center</align>
                <label>[B]QR unavailable[CR]use the code below[/B]</label>
                <visible>String.IsEmpty(Window.Property(tmdbmovies.auth_qr))</visible>
            </control>

            <!-- Text instructiuni (stanga) — font13 ca la Umbrella -->
            <control type="textbox" id="2001">
                <left>40</left><top>100</top><width>560</width><height>280</height>
                <font>font13</font><textcolor>FFCCCCCC</textcolor>
                <align>center</align>
                <aligny>center</aligny>
            </control>

            <!-- Bara de timp ramas (dimensiune Umbrella: 25px inalta) -->
            <control type="progress" id="5000">
                <description>Countdown</description>
                <top>405</top><left>20</left><width>880</width><height>25</height>
                <reveal>true</reveal>
                <visible>Integer.IsGreater(Window().Property(tmdbmovies.auth_percent),0)</visible>
            </control>

        </control>
    </controls>
</window>
