<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog">
    <defaultcontrol always="true">1000</defaultcontrol>
    <controls>

        <!-- ─── FUNDAL ─────────────────────────────────────────── -->
        <control type="image">
            <left>0</left><top>0</top><width>1920</width><height>1080</height>
            <texture colordiffuse="FF0D0D12">white.png</texture>
        </control>

        <!-- ─── CARDUL CENTRAL ─────────────────────────────────────────── -->
        <control type="group">
            <centerleft>50%</centerleft><centertop>50%</centertop>
            <width>1180</width><height>680</height>
            <animation effect="zoom" start="80" end="100" center="auto" time="250" tween="back" easing="out">WindowOpen</animation>
            <animation effect="fade" start="0" end="100" time="250">WindowOpen</animation>
            <animation effect="zoom" start="100" end="80" center="auto" time="200" tween="back" easing="in">WindowClose</animation>
            <animation effect="fade" start="100" end="0"  time="200">WindowClose</animation>

            <!-- Fundal cristal (ca la dialogul QR de autentificare) -->
            <control type="image">
                <left>0</left><top>0</top>
                <width>1180</width><height>680</height>
                <texture border="20">common/white_rounded.png</texture>
                <colordiffuse>992E2E2E</colordiffuse>
            </control>

            <!-- Buton invizibil (focus pentru mouse / tasta Enter) -->
            <control type="button" id="1000">
                <posx>-2000</posx><posy>-2000</posy><width>1</width><height>1</height>
                <label></label><texturefocus></texturefocus><texturenofocus></texturenofocus>
            </control>

            <!-- Iconita addonului -->
            <control type="image">
                <left>28</left><top>18</top><width>64</width><height>64</height>
                <texture>$INFO[Window.Property(tmdbmovies.auth_addon_icon)]</texture>
                <aspectratio>keep</aspectratio>
            </control>

            <!-- Heading -->
            <control type="label">
                <left>110</left><top>28</top><width>940</width><height>44</height>
                <font>font14</font><textcolor>FFCCCCCC</textcolor><align>center</align><aligny>center</aligny>
                <label>$INFO[Window.Property(tmdbmovies.auth_heading)]</label>
            </control>

            <!-- Divider -->
            <control type="image">
                <left>24</left><top>96</top><width>1132</width><height>1</height>
                <texture>white.png</texture><colordiffuse>2AFFFFFF</colordiffuse>
            </control>

            <!-- ── QR CODE ── -->
            <control type="image">
                <left>56</left><top>140</top><width>430</width><height>430</height>
                <texture>$INFO[Window.Property(tmdbmovies.auth_qr)]</texture>
                <aspectratio align="center" aligny="center">keep</aspectratio>
                <animation effect="fade" start="0" end="100" time="300">WindowOpen</animation>
                <visible>!String.IsEmpty(Window.Property(tmdbmovies.auth_qr))</visible>
            </control>
            <!-- Fallback text daca QR-ul nu a putut fi generat -->
            <control type="label">
                <left>56</left><top>330</top><width>430</width><height>90</height>
                <font>font12</font><textcolor>88FFFFFF</textcolor><align>center</align>
                <label>[B]QR unavailable[CR]use the link[/B]</label>
                <visible>String.IsEmpty(Window.Property(tmdbmovies.auth_qr))</visible>
            </control>

            <!-- Text: link + instructiuni -->
            <control type="textbox" id="2001">
                <left>520</left><top>130</top><width>620</width><height>200</height>
                <font>font13</font><textcolor>FFCCCCCC</textcolor>
                <align>center</align>
                <aligny>center</aligny>
            </control>

            <!-- Codul paste-ului, mare si bold, in buton cu margini rotunde -->
            <control type="group">
                <left>620</left><top>340</top><width>420</width><height>110</height>
                <visible>!String.IsEmpty(Window.Property(tmdbmovies.auth_code))</visible>

                <!-- fundal rotunjit -->
                <control type="image">
                    <left>0</left><top>0</top><width>420</width><height>110</height>
                    <texture border="28">common/white_rounded.png</texture>
                    <colordiffuse>33FFFFFF</colordiffuse>
                </control>

                <!-- codul -->
                <control type="label">
                    <left>10</left><top>0</top><width>400</width><height>110</height>
                    <font>font30</font><textcolor>FFFFD700</textcolor>
                    <align>center</align><aligny>center</aligny>
                    <label>[B]$INFO[Window.Property(tmdbmovies.auth_code)][/B]</label>
                </control>
            </control>

            <!-- Footer -->
            <control type="label">
                <left>520</left><top>486</top><width>620</width><height>64</height>
                <font>font12</font><textcolor>88FFFFFF</textcolor><align>center</align><aligny>center</aligny>
                <label>[B]Scan the QR code with your phone[CR]or open the link in a browser[/B]</label>
            </control>
            <control type="label">
                <left>24</left><top>600</top><width>1132</width><height>40</height>
                <font>font12</font><textcolor>66FFFFFF</textcolor><align>center</align><aligny>center</aligny>
                <label>[B]Press BACK or OK to close[/B]</label>
            </control>

            <!-- Bara de timp (ascunsa: percent = 0) -->
            <control type="progress" id="5000">
                <description>Countdown</description>
                <top>640</top><left>24</left><width>1132</width><height>20</height>
                <reveal>true</reveal>
                <visible>Integer.IsGreater(Window().Property(tmdbmovies.auth_percent),0)</visible>
            </control>

        </control>
    </controls>
</window>
