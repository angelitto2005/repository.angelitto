  <extension point="kodi.vfs" protocols="tmdbm" files="true" directories="false" filedirectories="false" supportBrowsing="false" supportDialog="false" supportWrite="false" label="TMDb Movies VFS" library_android="libvfs.tmdbm.so"/>
  <extension point="xbmc.addon.metadata">
