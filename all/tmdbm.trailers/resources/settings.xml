<?xml version="1.0" encoding="utf-8"?>
<settings version="2">
  <section id="tmdbm.trailers">
    <category id="general" label="32000">
      <group id="video" label="32002">
        <setting id="trailer_max_res" type="string" label="32010" help="32040">
          <level>0</level>
          <default>Auto (based on display)</default>
          <constraints>
            <options>
              <option>Auto (based on display)</option>
              <option>720p</option>
              <option>1080p</option>
              <option>2160p (4K)</option>
            </options>
          </constraints>
          <control type="list" format="string"/>
        </setting>
        <setting id="subtitles" type="string" label="32011" help="32041">
          <level>0</level>
          <default>off</default>
          <constraints>
            <options>
              <option label="32060">off</option>
              <option label="32061">original</option>
              <option label="32062">preferred language</option>
            </options>
          </constraints>
          <control type="list" format="string"/>
        </setting>
        <setting id="subtitle_language" type="string" label="32012" help="32042">
          <level>2</level>
          <default></default>
          <constraints><allowempty>true</allowempty></constraints>
          <control type="edit" format="string"/>
        </setting>
      </group>
      <group id="localisation" label="32003">
        <setting id="content_country" type="string" label="32013" help="32043">
          <level>0</level>
          <default>US</default>
          <constraints>
            <options>
              <option>AO</option>
              <option>AR</option>
              <option>AT</option>
              <option>AU</option>
