<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.video.newpipe" name="NewPipe MOD" version="1.4.32a" provider-name="Twilight0, TrainAgain2, [B][COLOR FF6AFB92]Angelitto[/COLOR][/B]">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>
    <extension point="xbmc.python.pluginsource" library="main.py">
        <provides>video audio</provides>
    </extension>
    <extension point="xbmc.service" library="resources/service.py" start="login" />
    <extension point="xbmc.addon.metadata">
        <platform>all</platform>
        <summary lang="en">Browse and watch YouTube videos</summary>
        <description lang="en"></description>
        <disclaimer lang="en">This addon does not host or distribute any content; it only browses publicly available YouTube pages. Optional account linking stores its session token only in the local Kodi add-on profile.</disclaimer>
        <language>en</language>
        <license>GPL-3.0-only</license>
        <source>https://github.com/Twilight0/plugin.video.newpipe</source>
        <assets>
            <icon>icon.png</icon>
            <fanart>fanart.jpg</fanart>
            <banner>resources/media/banner.jpg</banner>
            <clearlogo>resources/media/clearlogo.png</clearlogo>
        </assets>
    </extension>
</addon>
