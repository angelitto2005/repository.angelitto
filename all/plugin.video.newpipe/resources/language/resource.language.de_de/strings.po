msgctxt "#30037"
msgid "Direct playback maximum resolution"
msgstr "Maximale Direktwiedergabeauflösung"

msgctxt "#30038"
msgid "Uses one direct audio/video stream and avoids the failing DASH proxy."
msgstr "Verwendet einen einzelnen direkten Audio-/Videostream und umgeht den fehlerhaften DASH-Proxy."

msgctxt "#30039"
msgid "Fast start"
msgstr "Schneller Start"

msgctxt "#30040"
msgid "Prefer a 360p/480p direct stream when available. Disable this to prefer the highest selected resolution."
msgstr "Bevorzuge einen direkten Stream in 360p/480p, wenn verfügbar. Deaktiviere dies, um die höchste gewählte Auflösung zu bevorzugen."

msgctxt "#30041"
msgid "Custom country code (optional)"
msgstr "Benutzerdefinierter Ländercode (optional)"

msgctxt "#30042"
msgid "Enter any two-letter ISO 3166-1 country code. It overrides the country picker."
msgstr "Gib einen beliebigen zweistelligen ISO 3166-1 Ländercode ein. Er überschreibt die Länderauswahl."

msgctxt "#30043"
msgid "Custom language code (optional)"
msgstr "Benutzerdefinierter Sprachcode (optional)"

msgctxt "#30044"
msgid "Enter a YouTube language code such as pt, pt-PT, en or es. It overrides the language picker."
msgstr "Gib einen YouTube-Sprachcode ein, z. B. pt, pt-PT, en oder es. Er überschreibt die Sprachauswahl."

msgctxt "#30045"
msgid "Select the country used by YouTube to localize results."
msgstr "Wähle das Land, das YouTube zur Lokalisierung der Ergebnisse verwendet."

msgctxt "#30046"
msgid "Select the language used by YouTube to localize titles and results."
msgstr "Wähle die Sprache, die YouTube zur Lokalisierung von Titeln und Ergebnissen verwendet."

msgctxt "#30047"
msgid "Default Trending category"
msgstr "Standardkategorie für Trending"

msgctxt "#30048"
msgid "Choose the category that opens immediately when selecting Trending."
msgstr "Wähle die Kategorie, die beim Aufruf von Trending sofort geöffnet wird."

msgctxt "#30049"
msgid "Default Live category"
msgstr "Standardkategorie für Live"

msgctxt "#30050"
msgid "Choose the category that opens immediately when selecting Live."
msgstr "Wähle die Kategorie, die beim Aufruf von Live sofort geöffnet wird."

msgctxt "#30051"
msgid "Trailers"
msgstr "Trailer"

msgctxt "#30052"
msgid "Trailer language/version"
msgstr "Trailer-Sprache/-Version"

msgctxt "#30053"
msgid "Choose how trailers are searched. This is independent of the selected content country."
msgstr "Wähle, wie Trailer gesucht werden. Dies ist unabhängig vom gewählten Inhaltsland."

msgctxt "#30054"
msgid "Trailer maximum resolution"
msgstr "Maximale Trailerauflösung"

msgctxt "#30055"
msgid "Choose the resolution requested for trailers. 4K depends on availability, device decoding and InputStream Adaptive settings."
msgstr "Wähle die für Trailer angeforderte Auflösung. 4K hängt von Verfügbarkeit, Geräte-Decodierung und den Einstellungen von InputStream Adaptive ab."

