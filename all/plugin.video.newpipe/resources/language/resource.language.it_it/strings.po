msgctxt "#30077"
msgid "Imports the current account subscriptions after YouTube TV authorization."
msgstr "Importa le iscrizioni dell'account corrente dopo l'autorizzazione YouTube TV."

msgctxt "#30078"
msgid "Removes the local OAuth token only. It never changes your YouTube subscriptions."
msgstr "Rimuove solo il token OAuth locale. Non modifica mai le tue iscrizioni YouTube."

msgctxt "#30079"
msgid "YouTube account is already connected"
msgstr "Account YouTube già connesso"

msgctxt "#30080"
