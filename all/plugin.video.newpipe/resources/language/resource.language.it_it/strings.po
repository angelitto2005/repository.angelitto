msgctxt "#30037"
msgid "Direct playback maximum resolution"
msgstr "Risoluzione massima per la riproduzione diretta"

msgctxt "#30038"
msgid "Uses one direct audio/video stream and avoids the failing DASH proxy."
msgstr "Utilizza un singolo flusso audio/video diretto ed evita il proxy DASH che fallisce."

msgctxt "#30039"
msgid "Fast start"
msgstr "Avvio rapido"

msgctxt "#30040"
msgid "Prefer a 360p/480p direct stream when available. Disable this to prefer the highest selected resolution."
msgstr "Preferisci uno stream diretto a 360p/480p quando disponibile. Disabilita questa opzione per preferire la risoluzione massima selezionata."

msgctxt "#30041"
msgid "Custom country code (optional)"
msgstr "Codice paese personalizzato (opzionale)"

msgctxt "#30042"
msgid "Enter any two-letter ISO 3166-1 country code. It overrides the country picker."
msgstr "Inserisci un qualsiasi codice paese ISO 3166-1 di due lettere. Sovrascrive il selettore di paese."

msgctxt "#30043"
msgid "Custom language code (optional)"
msgstr "Codice lingua personalizzato (opzionale)"

msgctxt "#30044"
msgid "Enter a YouTube language code such as pt, pt-PT, en or es. It overrides the language picker."
msgstr "Inserisci un codice lingua di YouTube come pt, pt-PT, en o es. Sovrascrive il selettore di lingua."

msgctxt "#30045"
msgid "Select the country used by YouTube to localize results."
msgstr "Seleziona il paese che YouTube usa per localizzare i risultati."

msgctxt "#30046"
msgid "Select the language used by YouTube to localize titles and results."
msgstr "Seleziona la lingua che YouTube usa per localizzare titoli e risultati."

msgctxt "#30047"
msgid "Default Trending category"
msgstr "Categoria predefinita per Tendenze"

msgctxt "#30048"
msgid "Choose the category that opens immediately when selecting Trending."
msgstr "Scegli la categoria che si apre immediatamente selezionando Tendenze."

msgctxt "#30049"
msgid "Default Live category"
msgstr "Categoria predefinita per Live"

msgctxt "#30050"
msgid "Choose the category that opens immediately when selecting Live."
msgstr "Scegli la categoria che si apre immediatamente selezionando Live."

msgctxt "#30051"
msgid "Trailers"
msgstr "Trailer"

msgctxt "#30052"
msgid "Trailer language/version"
msgstr "Lingua/versione del trailer"

msgctxt "#30053"
msgid "Choose how trailers are searched. This is independent of the selected content country."
msgstr "Scegli come cercare i trailer. Questo è indipendente dal paese del contenuto selezionato."

msgctxt "#30054"
msgid "Trailer maximum resolution"
msgstr "Risoluzione massima per i trailer"

msgctxt "#30055"
msgid "Choose the resolution requested for trailers. 4K depends on availability, device decoding and InputStream Adaptive settings."
msgstr "Scegli la risoluzione richiesta per i trailer. Il 4K dipende dalla disponibilità, dalla decodifica del dispositivo e dalle impostazioni di InputStream Adaptive."

