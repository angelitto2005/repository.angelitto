msgid "Trailers"
msgstr "Tráilers"

msgctxt "#30052"
msgid "Trailer language/version"
msgstr "Idioma/versión del tráiler"

msgctxt "#30053"
msgid "Choose how trailers are searched. This is independent of the selected content country."
msgstr "Elige cómo se buscan los tráileres. Esto es independiente del país de contenido seleccionado."

msgctxt "#30054"
msgid "Trailer maximum resolution"
msgstr "Resolución máxima de tráileres"

msgctxt "#30055"
msgid "Choose the resolution requested for trailers. 4K depends on availability, device decoding and InputStream Adaptive settings."
msgstr "Elige la resolución solicitada para los tráileres. 4K depende de la disponibilidad, el decodificador del dispositivo y la configuración de InputStream Adaptive."

