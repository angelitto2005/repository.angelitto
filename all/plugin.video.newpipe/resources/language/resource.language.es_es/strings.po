msgid "Direct playback maximum resolution"
msgstr "Resolución máxima de reproducción directa"

msgctxt "#30038"
msgid "Uses one direct audio/video stream and avoids the failing DASH proxy."
msgstr "Usa un único flujo directo de audio/video y evita el proxy DASH que falla."

msgctxt "#30039"
msgid "Fast start"
msgstr "Inicio rápido"

msgctxt "#30040"
msgid "Prefer a 360p/480p direct stream when available. Disable this to prefer the highest selected resolution."
msgstr "Preferir una transmisión directa de 360p/480p cuando esté disponible. Desactiva esto para preferir la resolución más alta seleccionada."

msgctxt "#30041"
msgid "Custom country code (optional)"
msgstr "Código de país personalizado (opcional)"

msgctxt "#30042"
msgid "Enter any two-letter ISO 3166-1 country code. It overrides the country picker."
msgstr "Introduce cualquier código de país ISO 3166-1 de dos letras. Sobrescribe el selector de país."

msgctxt "#30043"
msgid "Custom language code (optional)"
msgstr "Código de idioma personalizado (opcional)"

msgctxt "#30044"
msgid "Enter a YouTube language code such as pt, pt-PT, en or es. It overrides the language picker."
msgstr "Introduce un código de idioma de YouTube como pt, pt-PT, en o es. Sobrescribe el selector de idioma."

msgctxt "#30045"
msgid "Select the country used by YouTube to localize results."
msgstr "Selecciona el país que YouTube usa para localizar los resultados."

msgctxt "#30046"
msgid "Select the language used by YouTube to localize titles and results."
msgstr "Selecciona el idioma que YouTube usa para localizar títulos y resultados."

msgctxt "#30047"
msgid "Default Trending category"
msgstr "Categoría predeterminada de Tendencias"

msgctxt "#30048"
msgid "Choose the category that opens immediately when selecting Trending."
msgstr "Elige la categoría que se abre inmediatamente al seleccionar Tendencias."

msgctxt "#30049"
msgid "Default Live category"
msgstr "Categoría predeterminada de En directo"

msgctxt "#30050"
msgid "Choose the category that opens immediately when selecting Live."
msgstr "Elige la categoría que se abre inmediatamente al seleccionar En directo."

