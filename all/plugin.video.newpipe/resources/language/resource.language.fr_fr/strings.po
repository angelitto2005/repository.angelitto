msgctxt "#30038"
msgid "Uses one direct audio/video stream and avoids the failing DASH proxy."
msgstr "Utilise un flux audio/vidéo direct unique et évite le proxy DASH défaillant."

msgctxt "#30039"
msgid "Fast start"
msgstr "Démarrage rapide"

msgctxt "#30040"
msgid "Prefer a 360p/480p direct stream when available. Disable this to prefer the highest selected resolution."
msgstr "Préférer un flux direct 360p/480p lorsque disponible. Désactivez ceci pour préférer la résolution sélectionnée la plus élevée."

msgctxt "#30041"
msgid "Custom country code (optional)"
msgstr "Code pays personnalisé (optionnel)"

msgctxt "#30042"
msgid "Enter any two-letter ISO 3166-1 country code. It overrides the country picker."
msgstr "Saisissez tout code pays ISO 3166-1 à deux lettres. Il remplace le sélecteur de pays."

msgctxt "#30043"
msgid "Custom language code (optional)"
msgstr "Code langue personnalisé (optionnel)"

msgctxt "#30044"
msgid "Enter a YouTube language code such as pt, pt-PT, en or es. It overrides the language picker."
msgstr "Saisissez un code langue YouTube comme pt, pt-PT, en ou es. Il remplace le sélecteur de langue."

msgctxt "#30045"
msgid "Select the country used by YouTube to localize results."
msgstr "Sélectionnez le pays utilisé par YouTube pour localiser les résultats."

msgctxt "#30046"
msgid "Select the language used by YouTube to localize titles and results."
msgstr "Sélectionnez la langue utilisée par YouTube pour localiser les titres et les résultats."

msgctxt "#30047"
msgid "Default Trending category"
msgstr "Catégorie par défaut des Tendances"

msgctxt "#30048"
msgid "Choose the category that opens immediately when selecting Trending."
msgstr "Choisissez la catégorie qui s'ouvre immédiatement lors de la sélection de Tendances."

msgctxt "#30049"
msgid "Default Live category"
msgstr "Catégorie par défaut du Direct"

msgctxt "#30050"
msgid "Choose the category that opens immediately when selecting Live."
msgstr "Choisissez la catégorie qui s'ouvre immédiatement lors de la sélection de Direct."

