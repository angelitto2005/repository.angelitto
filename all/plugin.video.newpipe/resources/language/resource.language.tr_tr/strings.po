msgctxt "#30041"
msgid "Custom country code (optional)"
msgstr "Özel ülke kodu (isteğe bağlı)"

msgctxt "#30042"
msgid "Enter any two-letter ISO 3166-1 country code. It overrides the country picker."
msgstr "Herhangi iki harfli ISO 3166-1 ülke kodu girin. Bu, ülke seçicinin yerini alır."

msgctxt "#30043"
msgid "Custom language code (optional)"
msgstr "Özel dil kodu (isteğe bağlı)"

msgctxt "#30044"
msgid "Enter a YouTube language code such as pt, pt-PT, en or es. It overrides the language picker."
msgstr "pt, pt-PT, en veya es gibi bir YouTube dil kodu girin. Bu, dil seçicinin yerini alır."

msgctxt "#30045"
msgid "Select the country used by YouTube to localize results."
msgstr "YouTube'un sonuçları yerelleştirmek için kullandığı ülkeyi seçin."

msgctxt "#30046"
msgid "Select the language used by YouTube to localize titles and results."
msgstr "YouTube'un başlıkları ve sonuçları yerelleştirmek için kullandığı dili seçin."

msgctxt "#30047"
msgid "Default Trending category"
msgstr "Varsayılan Trendler kategorisi"

