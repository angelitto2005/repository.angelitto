msgctxt "#30077"
msgid "Imports the current account subscriptions after YouTube TV authorization."
msgstr "YouTube TV yetkilendirmesinden sonra mevcut hesabın aboneliklerini içe aktarır."

msgctxt "#30078"
msgid "Removes the local OAuth token only. It never changes your YouTube subscriptions."
msgstr "Yalnızca yerel OAuth jetonunu kaldırır. YouTube aboneliklerinizi asla değiştirmez."

msgctxt "#30079"
msgid "YouTube account is already connected"
msgstr "YouTube hesabı zaten bağlı"

