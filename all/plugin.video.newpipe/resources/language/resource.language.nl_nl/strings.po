msgctxt "#30041"
msgid "Custom country code (optional)"
msgstr "Aangepaste landcode (optioneel)"

msgctxt "#30042"
msgid "Enter any two-letter ISO 3166-1 country code. It overrides the country picker."
msgstr "Voer een willekeurige tweeletterige ISO 3166-1-landcode in. Dit overschrijft de landkiezer."

msgctxt "#30043"
msgid "Custom language code (optional)"
msgstr "Aangepaste taalcode (optioneel)"

