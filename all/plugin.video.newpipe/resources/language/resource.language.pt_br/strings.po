msgctxt "#30074"
msgid "YouTube TV login method"
msgstr "Método de login do YouTube TV"

msgctxt "#30075"
msgid "Uses the current public YouTube TV client data, following NewPipe MOD's activation flow."
msgstr "Usa os dados do cliente público atual do YouTube TV, seguindo o fluxo de ativação do NewPipe MOD."

msgctxt "#30076"
msgid "Creates a YouTube TV activation code and QR. Authorize it with your Google account on another device."
msgstr "Cria um código de ativação e QR do YouTube TV. Autorize-o com sua conta Google em outro dispositivo."

msgctxt "#30077"
msgid "Imports the current account subscriptions after YouTube TV authorization."
msgstr "Importa as inscrições da conta atual após a autorização do YouTube TV."

msgctxt "#30078"
msgid "Removes the local OAuth token only. It never changes your YouTube subscriptions."
msgstr "Remove apenas o token OAuth local. Nunca altera suas inscrições do YouTube."

msgctxt "#30079"
msgid "YouTube account is already connected"
msgstr "Conta do YouTube já está conectada"

msgctxt "#30080"
msgid "QR link:"
