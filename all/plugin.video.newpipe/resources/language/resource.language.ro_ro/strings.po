msgid "Direct playback maximum resolution"
msgstr "Rezoluția maximă pentru redarea directă"

msgctxt "#30038"
msgid "Uses one direct audio/video stream and avoids the failing DASH proxy."
msgstr "Folosește un singur stream audio/video direct și evită proxy-ul DASH care dă erori."

msgctxt "#30039"
msgid "Fast start"
msgstr "Start rapid"

msgctxt "#30040"
msgid "Prefer a 360p/480p direct stream when available. Disable this to prefer the highest selected resolution."
msgstr "Preferă un stream direct la 360p/480p când este disponibil. Dezactivează această opțiune pentru a prefera cea mai înaltă rezoluție selectată."

msgctxt "#30041"
msgid "Custom country code (optional)"
msgstr "Cod țară personalizat (opțional)"

msgctxt "#30042"
msgid "Enter any two-letter ISO 3166-1 country code. It overrides the country picker."
msgstr "Introdu orice cod de țară ISO 3166-1 de două litere. Suprascrie selectorul de țară."

msgctxt "#30043"
msgid "Custom language code (optional)"
msgstr "Cod limbă personalizat (opțional)"

msgctxt "#30044"
msgid "Enter a YouTube language code such as pt, pt-PT, en or es. It overrides the language picker."
msgstr "Introdu un cod de limbă YouTube, de exemplu pt, pt-PT, en sau es. Suprascrie selectorul de limbă."

msgctxt "#30045"
msgid "Select the country used by YouTube to localize results."
msgstr "Selectează țara folosită de YouTube pentru localizarea rezultatelor."

msgctxt "#30046"
msgid "Select the language used by YouTube to localize titles and results."
msgstr "Selectează limba folosită de YouTube pentru localizarea titlurilor și a rezultatelor."

msgctxt "#30047"
msgid "Default Trending category"
msgstr "Categoria implicită pentru Tendințe"

msgctxt "#30048"
msgid "Choose the category that opens immediately when selecting Trending."
msgstr "Alege categoria care se deschide imediat când selectezi Tendințe."

msgctxt "#30049"
msgid "Default Live category"
msgstr "Categoria implicită pentru În direct"

msgctxt "#30050"
msgid "Choose the category that opens immediately when selecting Live."
msgstr "Alege categoria care se deschide imediat când selectezi În direct."

