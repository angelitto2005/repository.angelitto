msgid "YouTube TV login method"
msgstr "Metodă de autentificare YouTube TV"

msgctxt "#30075"
msgid "Uses the current public YouTube TV client data, following NewPipe MOD's activation flow."
msgstr "Folosește datele clientului public YouTube TV curent, urmând fluxul de activare al NewPipe MOD."

msgctxt "#30076"
msgid "Creates a YouTube TV activation code and QR. Authorize it with your Google account on another device."
msgstr "Creează un cod de activare YouTube TV și un QR. Autorizează-l cu contul tău Google pe un alt dispozitiv."

msgctxt "#30077"
msgid "Imports the current account subscriptions after YouTube TV authorization."
msgstr "Importă abonările contului curent după autorizarea YouTube TV."

msgctxt "#30078"
msgid "Removes the local OAuth token only. It never changes your YouTube subscriptions."
msgstr "Elimină doar tokenul OAuth local. Nu îți modifică niciodată abonările YouTube."

msgctxt "#30079"
msgid "YouTube account is already connected"
msgstr "Contul YouTube este deja conectat"

msgctxt "#30080"
